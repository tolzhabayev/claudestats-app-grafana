{
  "name": "timurdigital-claudestats-app",
  "version": "2.0.1",
  "description": "Claude Code team usage analytics for Grafana Cloud",
  "scripts": {
    "build": "rspack -c ./rspack.config.ts --env production",
    "dev": "rspack -w -c ./rspack.config.ts --env development",
    "e2e": "playwright test",
    "e2e:update": "playwright test -u",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "sign": "sign-plugin",
    "docs:serve": "plugin-docs-cli serve --port 3001 --reload",
    "docs:validate": "plugin-docs-cli validate"
  },
  "author": "Timur Digital",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-docs-cli": "^1.0.0",
    "@grafana/plugin-e2e": "^4.0.0",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@rspack/cli": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "identity-obj-proxy": "^3.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rspack-merge": "^1.0.1",
    "rspack-plugin-virtual-module": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "ts-checker-rspack-plugin": "^1.7.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "webpack": "^5.110.3",
    "ws": "^8.13.0"
  },
  "dependencies": {
    "@emotion/css": "^11.13.0",
    "@grafana/data": "13.2.4",
    "@grafana/i18n": "13.2.4",
    "@grafana/runtime": "13.2.4",
    "@grafana/scenes": "^8.17.0",
    "@grafana/schema": "13.2.4",
    "@grafana/ui": "13.2.4",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=24.5"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "serialize-javascript": "^7.0.5"
  }
}
